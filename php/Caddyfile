{
    log default {
          output stdout
          level DEBUG
    }
    frankenphp
}

:8080 {
    root * public/
    encode zstd br gzip
    php_server
    @git path /.git*
    respond @git "403 Forbidden" 403

    @cachedFiles {
        path_regexp cached ^/upload/resize_cache/.+\.(?:png|jpe?g|gif|webp)$
    }
    header @cachedFiles Cache-Control "public, max-age=31536000, immutable"

    @dirWithIndex {
        file {
            try_files {path}/index.php
        }
    }
    rewrite @dirWithIndex {path}/index.php

    @urlrewrite {
        not file
        not path /bitrix/urlrewrite.php
    }
    rewrite @urlrewrite /bitrix/urlrewrite.php

    handle_errors {
        @notfound expression {http.error.status_code} == 404
        rewrite @notfound /index.php
    }

    @blocked {
        path /bitrix/php_interface/dbconn.php
        path /bitrix/.settings.php
    }
    respond @blocked 403
}
